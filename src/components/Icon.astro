---
import * as icons from 'lucide-static';

interface Props {
  name: string;
  size?: number;
  class?: string;
  strokeWidth?: number;
  label?: string;
  [key: `data-${string}`]: unknown;
}

const { name, size = 24, class: className = '', strokeWidth = 2, label, ...rest } = Astro.props;
const key = name
  .split('-')
  .map((p) => p.charAt(0).toUpperCase() + p.slice(1))
  .join('') as keyof typeof icons;
const raw = icons[key] as string | undefined;
if (!raw) throw new Error(`Onbekend icoon: ${name}`);
const inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['icon', className]}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  {...rest}
  set:html={inner}
/>
