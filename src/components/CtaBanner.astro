---
import Icon from './Icon.astro';

interface Props {
  title?: string;
  text?: string;
  button?: string;
  href?: string;
}
const {
  title = 'Op zoek naar een betrouwbare technische partner?',
  text = 'Bespreek uw project met ETI N.V. en ontdek welke technische oplossing bij uw situatie past.',
  button = 'Vraag een offerte aan',
  href = '/contact/#offerte',
} = Astro.props;
---

<section class="cta-section" aria-labelledby="cta-titel">
  <div class="container">
    <div class="cta" data-reveal>
      <div class="cta-arc" aria-hidden="true"></div>
      <div class="cta-content">
        <h2 id="cta-titel">{title}</h2>
        <p>{text}</p>
      </div>
      <a href={href} class="btn btn--yellow cta-btn">
        {button}
        <Icon name="arrow-right" class="icon-arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding-block: clamp(48px, 7vw, 88px);
  }
  .cta {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    padding: clamp(32px, 5vw, 56px);
    border-radius: var(--radius-lg);
    background: linear-gradient(120deg, var(--navy) 0%, var(--blue) 100%);
    color: #dbe5f7;
    box-shadow: var(--shadow-lg);
  }
  .cta-arc {
    position: absolute;
    right: -120px;
    top: -160px;
    width: 460px;
    height: 460px;
    border-radius: 50%;
    border: 26px solid rgba(255, 196, 0, 0.9);
    border-left-color: transparent;
    border-bottom-color: transparent;
    transform: rotate(-12deg);
    opacity: 0.35;
    pointer-events: none;
  }
  .cta-content {
    position: relative;
    max-width: 640px;
  }
  .cta h2 {
    color: var(--white);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
  }
  .cta p {
    margin: 0;
    font-size: 1.1rem;
  }
  .cta-btn {
    position: relative;
  }
</style>
