# Kopieer naar .env en vul de echte waarden in. Zet .env NOOIT in git of in frontendcode.

# Publiek domein (gebruikt voor canonical-URL's, sitemap en robots.txt) – nodig tijdens "npm run build"
SITE_URL=https://www.uwdomein.sr

# Webserver
PORT=4321
# Zet op 1 (of true) als de site achter een reverse proxy (Nginx, Cloudflare, hosting-loadbalancer) draait
TRUST_PROXY=false

# E-mailaflevering van offerteaanvragen (verplicht – zonder deze gegevens geeft het formulier een foutmelding)
SMTP_HOST=smtp.uwprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Website ETI N.V. <website@uwdomein.sr>"
MAIL_TO=offertes@uwdomein.sr

# Optioneel: Cloudflare Turnstile (extra spambescherming)
# PUBLIC_TURNSTILE_SITE_KEY wordt bij "npm run build" in de pagina gezet; de geheime sleutel alleen op de server.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
